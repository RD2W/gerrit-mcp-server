# Gerrit MCP Server — Environment Variables
# Copy this file to config/.env and fill in your values.
# Every variable here overrides the corresponding field in config.toml.
#
# Naming convention:
#   GERRIT_*  — Gerrit connection settings ([gerrit] section)
#   MCP_*     — server-level infrastructure (service, cache, rate_limit, transport, log)
#   RUST_LOG  — standard Rust log level (overridden by MCP_LOG_LEVEL if both set)
#   SSL_*     — standard OpenSSL-style TLS environment variables
# ---------------------------------------------------------------------------

# --- Gerrit: connection ------------------------------------------------
# Base URL of the Gerrit instance (required).
# Example: https://gerrit.example.com
# GERRIT_URL=https://gerrit.example.com

# HTTP request timeout in seconds. Parsed as u64. 30 by default.
# GERRIT_TIMEOUT_SECS=60

# --- Gerrit: TLS certificates ------------------------------------------
# Path to a custom CA certificate PEM file.
# GERRIT_CA_CERT=/path/to/custom-ca.pem

# Alternative env var for CA cert PEM file (same effect as GERRIT_CA_CERT).
# Note: GERRIT_CA_CERT is checked first, then SSL_CERT_FILE (overrides it if both set).
# SSL_CERT_FILE=/path/to/custom-ca.pem

# Directory of CA certificate files.
# SSL_CERT_DIR=/etc/ssl/certs

# Enable/disable TLS certificate verification.
# Accepts: true/1/yes (enable) or false/0/no (disable). Unknown values are ignored.
# GERRIT_VERIFY_SSL=false

# --- Gerrit: authentication --------------------------------------------
# Credentials are loaded indirectly — config.toml specifies which env var
# to read (username_env, auth_token_env, token_env). The actual env var
# names are set in config, not here. Common defaults:

# Mode: http_basic / basic — HTTP Basic Auth
# GERRIT_USERNAME=your-username
# GERRIT_AUTH_TOKEN=your-http-password

# Mode: bearer / token — Bearer token auth
# GERRIT_TOKEN=your-bearer-token

# Mode: git_cookies — Git cookies file auth (configure gitcookies_path in TOML, no env vars needed)
# Mode: none — anonymous access (no credentials)

# --- Service: default behaviour ----------------------------------------
# Default maximum number of results returned by queries. Parsed as u32. 25 by default.
# MCP_DEFAULT_MAX_RESULTS=50

# Disable all write operations (create, update, delete). All read tools remain available.
# Accepts: true/1/yes (enable read-only) or false/0/no (disable). Unknown values are silently ignored.
# READ_ONLY_MODE=true

# --- Cache -------------------------------------------------------------
# Enable the in-memory TTL+LRU cache.
# Accepts: true/1/yes (enable) or false/0/no (disable). Unknown values are silently ignored.
# MCP_CACHE_ENABLED=true

# Cache entry time-to-live in seconds. Parsed as u64. 300 by default.
# MCP_CACHE_TTL_SECS=600

# Maximum number of cached entries (LRU eviction). Parsed as usize. 1000 by default.
# MCP_CACHE_MAX_ENTRIES=500

# --- Rate limiting -----------------------------------------------------
# Enable the token-bucket rate limiter.
# Accepts: true/1/yes (enable) or false/0/no (disable). Unknown values are silently ignored.
# MCP_RATE_LIMIT_ENABLED=true

# Sustained request rate (average per second). Parsed as u32. 10 by default.
# MCP_RATE_LIMIT_RPS=15

# Burst capacity (max instantaneous requests). Parsed as u32. 20 by default.
# MCP_RATE_LIMIT_BURST=30

# --- Transport ---------------------------------------------------------
# Transport mode: "stdio", "http", or "both". "both" by default.
# MCP_TRANSPORT=http

# HTTP server bind address (interface:port). "127.0.0.1:8080" by default.
# MCP_BIND_ADDR=0.0.0.0:8080

# URL path for the MCP Streamable HTTP endpoint. "/mcp" by default.
# MCP_HTTP_PATH=/mcp

# Liveness check endpoint path. "/healthz" by default.
# MCP_HEALTH_PATH=/healthz

# Readiness check endpoint path. "/readyz" by default.
# MCP_READY_PATH=/readyz

# Prometheus metrics endpoint path. "/metrics" by default.
# MCP_METRICS_PATH=/metrics

# Allowed hosts for DNS rebinding protection (comma-separated).
# Example: host1,host2,host3
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,gerrit-mcp

# Bearer token for MCP endpoint authentication (empty = disabled).
# MCP_AUTH_TOKEN=my-secret-mcp-token

# --- Logging -----------------------------------------------------------
# Log level: trace, debug, info, warn, error. "info" by default.
# RUST_LOG=debug

# Alternative log level — checked after RUST_LOG, so MCP_LOG_LEVEL wins if both set.
# MCP_LOG_LEVEL=trace
